rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Herbalife Wellness Stall: Attendee Leads & Game Vouchers
    match /stall_leads/{leadId} {
      // Allow kiosk attendees and stall coaches to record leads and retrieve rewards
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
